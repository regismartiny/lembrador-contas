<!DOCTYPE html>
<html lang="pt-br" class="dark-theme">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/stylesheets/starter-template.css">
    <title>Emails Não Lidos - Lembrador de Contas</title>
</head>
<body>
    <div class="container">
        <div class="starter-template">
            <h1 class="title-1">Lista de Emails Não Lidos</h1>
            <ul class="pl-3">
                <% messageList.forEach(function(msg){ %>
                    <li class="mb-2" style="word-break:break-all"><a href="/emails/get/<%= msg.id %>"><%= msg.id %></a></li>
                <%})%>
            </ul>
        </div>
    </div>
</body>
</html>